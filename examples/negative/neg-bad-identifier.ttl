# AUTHORED-BY Claude Fable
# NEGATIVE fixture (isolated): valid EXCEPT the identifier is a bare number
# ("42", a GitHub issue number) instead of a UC-<slug> stable identifier.
# Expected sole Violation: the dcterms:identifier sh:pattern constraint.
# scripts/validate-ucr.sh asserts this fixture is REJECTED.
# EXPECTED-VIOLATION: constraint=sh:PatternConstraintComponent path=dcterms:identifier

@prefix :        <https://jeswr.org/lws/ucr#> .
@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:UC-bad-id a lws-ucr:UseCase ;
    dcterms:identifier "42" ; dcterms:title "Bad identifier"@en ;
    dcterms:description "ctx"@en ;
    lws-ucr:primaryActor role:User ; lws-ucr:actor role:User ;
    lws-ucr:goal "g"@en ; lws-ucr:benefit "b"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
