# AUTHORED-BY Claude Fable
# NEGATIVE fixture (isolated): a use case that is valid in every respect EXCEPT
# it is identified by a BLANK NODE rather than an IRI, violating the stable-IRI
# identity model. Expected sole Violation: UseCaseShape's sh:nodeKind sh:IRI on
# the focus node. scripts/validate-ucr.sh asserts this fixture is REJECTED.
# EXPECTED-VIOLATION: constraint=sh:NodeKindConstraintComponent path=- sourceShape=ucrsh:UseCaseShape

@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

[] a lws-ucr:UseCase ;
    dcterms:identifier "UC-blank" ; dcterms:title "Blank-node use case"@en ;
    dcterms:description "ctx"@en ;
    lws-ucr:primaryActor role:User ; lws-ucr:actor role:User ;
    lws-ucr:goal "g"@en ; lws-ucr:benefit "b"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
