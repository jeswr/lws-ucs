# AUTHORED-BY Claude Fable
# NEGATIVE fixture (isolated): valid (with a valid primaryActor) EXCEPT one of
# the actor values is an lws-ucr:ActorRole that is NOT in the ActorRoleScheme.
# Expected sole Violation: the lws-ucr:actor skos:inScheme sh:hasValue constraint.
# scripts/validate-ucr.sh asserts this fixture is REJECTED.
# EXPECTED-VIOLATION: constraint=sh:HasValueConstraintComponent path=skos:inScheme

@prefix :        <https://jeswr.org/lws/ucr#> .
@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

:RogueRole a lws-ucr:ActorRole ; skos:inScheme :SomeOtherScheme ; skos:prefLabel "Rogue"@en .

:UC-wrong-scheme-actor a lws-ucr:UseCase ;
    dcterms:identifier "UC-wrong-scheme-actor" ; dcterms:title "Wrong-scheme actor"@en ;
    dcterms:description "ctx"@en ;
    lws-ucr:primaryActor role:User ;
    lws-ucr:actor role:User , :RogueRole ;
    lws-ucr:goal "g"@en ; lws-ucr:benefit "b"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
