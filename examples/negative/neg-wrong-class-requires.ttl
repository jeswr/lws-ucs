# NEGATIVE fixture (isolated): a valid use case and requirement whose
# dcterms:requires value is an IRI, but is an earl:TestCase rather than an
# lws-ucr:Requirement. Expected sole Violation: the dcterms:requires sh:class constraint.
# EXPECTED-VIOLATION: constraint=sh:ClassConstraintComponent path=dcterms:requires

@prefix :        <https://jeswr.org/lws/ucr#> .
@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix feat:    <https://jeswr.org/ns/lws-ucr/features#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix earl:    <http://www.w3.org/ns/earl#> .

:NotARequirement a earl:TestCase .

:UC-wrong-class-requires a lws-ucr:UseCase ;
    dcterms:identifier "UC-wrong-class-requires" ;
    dcterms:title "Wrong-class requires target"@en ;
    dcterms:description "ctx"@en ;
    lws-ucr:primaryActor role:User ; lws-ucr:actor role:User ;
    lws-ucr:goal "g"@en ; lws-ucr:benefit "b"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> ;
    lws-ucr:motivates :REQ-wrong-class-requires .

:REQ-wrong-class-requires a lws-ucr:Requirement ;
    dcterms:identifier "REQ-wrong-class-requires" ;
    dcterms:title "Wrong-class requires target"@en ;
    dcterms:description "The protocol MUST do the thing."@en ;
    dcterms:requires :NotARequirement ;
    lws-ucr:requirementType lws-ucr:Functional ; lws-ucr:priority lws-ucr:Must ;
    lws-ucr:rationale "r"@en ; lws-ucr:motivatedBy :UC-wrong-class-requires ;
    lws-ucr:relatedFeature feat:ResourceManagement ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
