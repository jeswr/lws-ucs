# NEGATIVE fixture (isolated): a valid use case and requirement whose verifiedBy
# value is an IRI, but is a skos:Concept rather than an earl:TestCase. Expected
# sole Violation: the lws-ucr:verifiedBy sh:class constraint.
# EXPECTED-VIOLATION: constraint=sh:ClassConstraintComponent path=lws-ucr:verifiedBy

@prefix :        <https://jeswr.org/lws/ucr#> .
@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix feat:    <https://jeswr.org/ns/lws-ucr/features#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

:NotATestCase a skos:Concept .

:UC-wrong-class-verifiedby a lws-ucr:UseCase ;
    dcterms:identifier "UC-wrong-class-verifiedby" ;
    dcterms:title "Wrong-class verifiedBy target"@en ;
    dcterms:description "ctx"@en ;
    lws-ucr:primaryActor role:User ; lws-ucr:actor role:User ;
    lws-ucr:goal "g"@en ; lws-ucr:benefit "b"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> ;
    lws-ucr:motivates :REQ-wrong-class-verifiedby .

:REQ-wrong-class-verifiedby a lws-ucr:Requirement ;
    dcterms:identifier "REQ-wrong-class-verifiedby" ;
    dcterms:title "Wrong-class verifiedBy target"@en ;
    dcterms:description "The protocol MUST do the thing."@en ;
    lws-ucr:requirementType lws-ucr:Functional ; lws-ucr:priority lws-ucr:Must ;
    lws-ucr:rationale "r"@en ; lws-ucr:motivatedBy :UC-wrong-class-verifiedby ;
    lws-ucr:relatedFeature feat:ResourceManagement ;
    lws-ucr:verifiedBy :NotATestCase ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
