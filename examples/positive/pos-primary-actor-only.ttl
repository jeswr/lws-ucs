# AUTHORED-BY Claude Fable
# POSITIVE fixture: a use case that states ONLY its primaryActor (no separate
# lws-ucr:actor triple). Because primaryActor is rdfs:subPropertyOf actor it is
# semantically also an actor, so this is a well-formed use case and MUST conform.
# Guards the fix for the finding that a separate mandatory actor minCount wrongly
# rejected a primary-only use case (validation runs without RDFS inference).
# scripts/validate-ucr.sh asserts this fixture CONFORMS.

@prefix :        <https://jeswr.org/lws/ucr#> .
@prefix lws-ucr: <https://jeswr.org/ns/lws-ucr#> .
@prefix role:    <https://jeswr.org/ns/lws-ucr/roles#> .
@prefix cat:     <https://jeswr.org/ns/lws-ucr/categories#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:UC-primary-only a lws-ucr:UseCase ;
    dcterms:identifier "UC-primary-only" ; dcterms:title "Primary actor only"@en ;
    dcterms:description "A use case that names only its primary actor."@en ;
    lws-ucr:primaryActor role:User ;
    lws-ucr:goal "to do the thing"@en ; lws-ucr:benefit "the benefit follows"@en ;
    lws-ucr:category cat:DataManagement ; lws-ucr:status lws-ucr:Accepted ;
    lws-ucr:sourceIssue <https://github.com/w3c/lws-ucs/issues/1> .
